0780(20) <'00:MANUTENCAO'>
0790*
0800END-DEFINE /* ==========================================================
0810*
0820** ------< Inicializacao de Variaveis >------------------------------ **
0830*
0840NQ06-DESC-SITC := '  '
0850NQ06-CODG-RETN := 9999
0860NQ06-MENS-RETN := '<NQ06> Erro não identificado'
0870*
0880** ------< Validacao dos parametros de Entrada >--------------------- **
0890*
0900IF NQ06-CODG-SITC = ' '
0910  NQ06-CODG-RETN := 0001
0920  NQ06-MENS-RETN := '<NQ06> Codigo da situacao não informado'
0930  ESCAPE MODULE
0940END-IF
0950*
0960** ------< Processamento da solicitacao > --------------------------- **
0970*
0980FOR WIN-PESK = 1 TO 20
0990*
1000  IF WTB-CODG-SITC(WIN-PESK) EQ ' '
1010    ESCAPE TOP
1020  END-IF
1030*
1040  SEPARATE WTB-CODG-SITC(WIN-PESK) INTO
1050    WAX-CODG-SITC WAX-DESC-SITC IGNORE WITH DELIMITER ':'
1060*
1070  IF WAX-CODG-SITC EQ NQ06-CODG-SITC
1080    NQ06-DESC-SITC := WAX-DESC-SITC
1090    NQ06-CODG-RETN := 0000
1100    NQ06-MENS-RETN := 'Operacao realizada com Sucesso'
1110    ESCAPE MODULE
1120  END-IF
1130*
1140END-FOR
1150*
1160COMPRESS '<' NQ06-CODG-SITC '>' INTO WAX-FILD-EDIT LEAVE NO SPACE
1170NQ06-CODG-RETN := 0002
1180compress '<NQ06> Codigo de Situacao nao cadastrado' wax-fild-edit
1190  into NQ06-MENS-RETN
1200*
1210*
1220END
